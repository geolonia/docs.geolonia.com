---
/**
 * 動くデモの実体ページ（iframe の中身）。
 *
 * src/demos/<slug>/<lens>.<ext> を1つ置けば、ここが自動で /demos/<slug>/<lens>/ を生やす。
 * デモを増やすのにハーネスを書く必要はない。
 *
 * 実行方式は拡張子で決まる（src/lib/snippets.ts の説明を参照）：
 *   .html … ビルド時にそのまま埋め込む（中の <script> もそのまま動く）
 *   .ts   … #map を用意し、クライアントでモジュールを import して実行
 *   .tsx  … #root を用意し、同じくモジュール側で React をマウント
 *
 * 地図はデモキーの対象環境（localhost / GitHub Pages / CodePen / Netlify / Vercel 等）
 * で描画される。完全な許可ドメインは explanation/free-referers 参照。
 */
import DemoLayout from '../../../layouts/DemoLayout.astro';
import { listSnippets, getSnippet } from '../../../lib/snippets';

export function getStaticPaths() {
  return listSnippets().map((s) => ({ params: { slug: s.slug, lens: s.lens } }));
}

const { slug, lens } = Astro.params as { slug: string; lens: string };
const snippet = getSnippet(slug, lens);
---
<DemoLayout title={`${lens} — ${slug}`}>
  {snippet.ext === 'html' && <Fragment set:html={snippet.raw} />}
  {snippet.ext === 'ts' && <div id="map" data-module={snippet.path}></div>}
  {snippet.ext === 'tsx' && <div id="root" data-module={snippet.path}></div>}
</DemoLayout>

<script>
  // data-module が指すスニペットだけをクライアントで読み込んで実行する。
  // import.meta.glob は各スニペットを別チャンクに分けるので、
  // このページで実際に落ちてくるのは該当の1つだけ。
  const modules = import.meta.glob('/src/demos/**/*.{ts,tsx}');
  const mount = document.querySelector<HTMLElement>('[data-module]');
  const path = mount?.dataset.module;
  if (path) {
    const load = modules[path];
    if (load) {
      load();
    } else {
      console.error(`[demo] スニペットを読み込めません: ${path}`);
    }
  }
</script>
