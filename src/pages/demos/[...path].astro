---
/**
 * 動くデモの実体ページ（iframe の中身）。
 *
 * src/demos/<slug>/<lens>.<ext> を1つ置けば、ここが自動で /demos/<slug>/<lens>/ を生やす。
 * デモを増やすのにハーネスを書く必要はない。slug は本体の構成をそのままミラーする
 * （例 src/demos/tutorials/embed/first-map/embed.html → /demos/tutorials/embed/first-map/embed/）。
 *
 * 実行方式は拡張子で決まる（src/lib/snippets.ts の説明を参照）：
 *   .html      … ビルド時にそのまま埋め込む（中の <script> もそのまま動く）。
 *                <!doctype> で始まる完全な HTML ならページ全体として出力する。
 *   .js / .ts  … #map を用意し、クライアントでモジュールを import して実行
 *   .jsx/.tsx  … #root を用意し、同じくモジュール側で React をマウント
 *
 * 地図はデモキーの対象環境（localhost / GitHub Pages / CodePen / Netlify / Vercel 等）
 * で描画される。完全な許可ドメインは explanation/free-referers 参照。
 */
import DemoLayout from '../../layouts/DemoLayout.astro';
import { listSnippets, getSnippet, isFullDocument, isReactSnippet, isModuleSnippet } from '../../lib/snippets';

export function getStaticPaths() {
  return listSnippets().map((s) => ({ params: { path: `${s.slug}/${s.lens}` } }));
}

const { path } = Astro.params as { path: string };
const idx = path.lastIndexOf('/');
const snippet = getSnippet(path.slice(0, idx), path.slice(idx + 1));
const fullDocument = snippet.ext === 'html' && isFullDocument(snippet.raw);
---
{fullDocument ? (
  <Fragment set:html={snippet.raw} />
) : (
  <DemoLayout title={`${snippet.lens} — ${snippet.slug}`}>
    {snippet.ext === 'html' && <Fragment set:html={snippet.raw} />}
    {isModuleSnippet(snippet.ext) && (
      <div id={isReactSnippet(snippet.ext) ? 'root' : 'map'} data-module={snippet.path}></div>
    )}

    <script>
      // data-module が指すスニペットだけをクライアントで読み込んで実行する。
      // import.meta.glob は各スニペットを別チャンクに分けるので、
      // このページで実際に落ちてくるのは該当の1つだけ。
      const modules = import.meta.glob('/src/demos/**/*.{js,jsx,ts,tsx}');
      const mount = document.querySelector<HTMLElement>('[data-module]');
      const modulePath = mount?.dataset.module;
      if (modulePath) {
        const load = modules[modulePath];
        if (load) {
          load();
        } else {
          console.error(`[demo] スニペットを読み込めません: ${modulePath}`);
        }
      }
    </script>
  </DemoLayout>
)}
