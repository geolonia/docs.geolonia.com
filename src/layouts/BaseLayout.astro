---
// 全ページ共通の外枠。CSS は src/styles/ から読み込むだけ（分離方針）。
import '../styles/ds-tokens.css'; // Geolonia デザインシステム（エイリアス元。必ず tokens.css より先）
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';

const { title = 'Geolonia Docs', page = '', lens = 'embed' } = Astro.props;

const nav = [
  { href: '/',             sec: 'home',        label: '入口' },
  { href: '/tutorials/',   sec: 'tutorial',    label: 'チュートリアル' },
  { href: '/howto/',       sec: 'howto',       label: 'ハウツー' },
  { href: '/reference/',   sec: 'reference',   label: 'リファレンス' },
  { href: '/explanation/', sec: 'explanation', label: '解説' },
];
---
<!doctype html>
<html lang="ja" data-theme="orange">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body data-page={page}>
    <header class="site-top">
      <a class="brand" href="/"><img class="brand-logo" src="/logo-docs.svg" alt="Geolonia Docs" width="166" height="26" /><span class="v2">v2</span></a>
      <nav class="dtx-nav">
        {nav.map((n) => (
          <a href={n.href} data-sec={n.sec} class={page === n.sec ? 'active' : ''}>{n.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="site-foot">
      <div class="site-foot__inner">
        <div class="site-foot__brand">
          <a class="site-foot__logo" href="https://docs.geolonia.com/"><span class="dot"></span>Geolonia 公式ドキュメント</a>
          <p class="site-foot__copyright">Copyright &copy; 2020 - Geolonia.com<br />All rights reserved.</p>
        </div>
        <ul class="site-foot__social">
          <li>
            <a class="site-foot__social-link" href="https://github.com/geolonia/docs.geolonia.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub リポジトリを開く">
              <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            </a>
          </li>
        </ul>
      </div>
    </footer>

    <!-- 記事内レンズタブ：連続する .lens 兄弟を1つのタブ群にまとめ、直下のコードを切り替える。
         選択中のレンズ（ライブラリ）はサイト全体で同期し、localStorage に保存して
         ページ遷移後も保持する。ページ内の全タブ群が連動する。
         JS 無効時は先頭レンズのみ表示。 -->
    <script>
      (function initLensTabs() {
        const KEY = 'geolonia-docs-lens';
        const read = () => { try { return localStorage.getItem(KEY); } catch (e) { return null; } };
        const write = (v) => { try { localStorage.setItem(KEY, v); } catch (e) {} };

        const groups = [];
        const seen = new Set();
        document.querySelectorAll('.lens').forEach((first) => {
          if (seen.has(first)) return;
          const prev = first.previousElementSibling;
          if (prev && prev.classList.contains('lens')) return; // 群の途中はスキップ
          const panels = [];
          let el = first;
          while (el && el.classList && el.classList.contains('lens')) {
            panels.push(el);
            seen.add(el);
            el = el.nextElementSibling;
          }
          if (panels.length < 2) { panels.forEach((p) => (p.hidden = false)); return; }

          const names = panels.map((p) => [...p.classList].find((c) => c !== 'lens') || 'code');
          const bar = document.createElement('div');
          bar.className = 'lens-tabs__bar';
          bar.setAttribute('role', 'tablist');
          const buttons = names.map((name) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'lens-tab';
            b.dataset.lens = name;
            b.setAttribute('role', 'tab');
            b.textContent = name;
            b.addEventListener('click', () => { write(name); applyAll(name); });
            bar.appendChild(b);
            return b;
          });
          panels[0].parentNode.insertBefore(bar, panels[0]);
          groups.push({ panels, buttons, names });
        });

        function applyAll(lens) {
          groups.forEach(({ panels, buttons, names }) => {
            let idx = names.indexOf(lens); // その群に無ければ先頭を表示（全体の保存値は変えない）
            if (idx < 0) idx = 0;
            panels.forEach((p, j) => (p.hidden = j !== idx));
            buttons.forEach((b, j) => {
              b.classList.toggle('active', j === idx);
              b.setAttribute('aria-selected', j === idx ? 'true' : 'false');
            });
          });
        }

        applyAll(read() || 'embed');
      })();

      // 動くデモ（LiveCode の iframe）の遅延ロード。
      // data-src だけ持つ iframe を、ビューポートに入った時に初めて読み込む。
      // タブで表示に切り替わった時も（display 変化で交差判定され）読み込まれる。
      (function initLazyDemos() {
        const load = (f) => {
          if (!f.getAttribute('src')) f.setAttribute('src', f.getAttribute('data-src'));
        };
        const frames = document.querySelectorAll('iframe[data-src]');
        if (!('IntersectionObserver' in window)) { frames.forEach(load); return; }
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { load(e.target); obs.unobserve(e.target); }
          });
        }, { rootMargin: '200px' });
        frames.forEach((f) => io.observe(f));
      })();
    </script>
  </body>
</html>
