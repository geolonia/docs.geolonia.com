---
// 全ページ共通の外枠。CSS は src/styles/ から読み込むだけ（分離方針）。
import '../styles/ds-tokens.css'; // Geolonia デザインシステム（エイリアス元。必ず tokens.css より先）
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';

const { title = 'Geolonia Docs', page = '', lens = 'embed' } = Astro.props;

const nav = [
  { href: '/',             sec: 'home',        label: '入口' },
  { href: '/tutorials/',   sec: 'tutorial',    label: 'チュートリアル' },
  { href: '/howto/',       sec: 'howto',       label: 'ハウツー' },
  { href: '/reference/',   sec: 'reference',   label: 'リファレンス' },
  { href: '/explanation/', sec: 'explanation', label: '解説' },
];
---
<!doctype html>
<html lang="ja" data-theme="orange">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body data-page={page}>
    <header class="site-top">
      <a class="brand" href="/"><span class="dot"></span>Geolonia Docs <span class="v2">v2</span></a>
      <nav class="dtx-nav">
        {nav.map((n) => (
          <a href={n.href} data-sec={n.sec} class={page === n.sec ? 'active' : ''}>{n.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="site-foot">プロトタイプ（docs-astro）。地図は localhost / *.github.io で実描画されます。</footer>

    <!-- 記事内レンズタブ：連続する .lens 兄弟を1つのタブ群にまとめ、直下のコードを切り替える。
         タブ群ごとに独立（同期・記憶なし）。JS 無効時は先頭レンズのみ表示。 -->
    <script>
      function buildLensTabs(group) {
        if (group.length < 2) { group.forEach((p) => (p.hidden = false)); return; }
        const bar = document.createElement('div');
        bar.className = 'lens-tabs__bar';
        bar.setAttribute('role', 'tablist');
        const buttons = group.map((panel, i) => {
          const name = [...panel.classList].find((c) => c !== 'lens') || 'code';
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'lens-tab' + (i === 0 ? ' active' : '');
          b.dataset.lens = name;
          b.setAttribute('role', 'tab');
          b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
          b.textContent = name;
          b.addEventListener('click', () => {
            group.forEach((p, j) => (p.hidden = j !== i));
            buttons.forEach((btn, j) => {
              btn.classList.toggle('active', j === i);
              btn.setAttribute('aria-selected', j === i ? 'true' : 'false');
            });
          });
          return b;
        });
        buttons.forEach((b) => bar.appendChild(b));
        group[0].parentNode.insertBefore(bar, group[0]);
        group.forEach((p, i) => (p.hidden = i !== 0));
      }
      (function initLensTabs() {
        const seen = new Set();
        document.querySelectorAll('.lens').forEach((first) => {
          if (seen.has(first)) return;
          const prev = first.previousElementSibling;
          if (prev && prev.classList.contains('lens')) return; // 群の途中はスキップ
          const group = [];
          let el = first;
          while (el && el.classList && el.classList.contains('lens')) {
            group.push(el);
            seen.add(el);
            el = el.nextElementSibling;
          }
          buildLensTabs(group);
        });
      })();
    </script>
  </body>
</html>
