---
// 自動生成 API Markdown 用のレイアウト。
// md 側に既に H1 があるのでここでは h1 を注入しない。TypeDoc のパンくずは
// astro.config.mjs の remarkStripTypedocBreadcrumb が落としているので、
// ナビゲーションは左のツリーだけが担う。
//
// ツリーは src/pages/reference/**/*.md を走査して組み立てる。手で維持する
// 一覧を持たない（持つと TypeDoc の再生成とずれる）。
import BaseLayout from './BaseLayout.astro';
import ApiNav from '../components/ApiNav.astro';
import { packageLabel } from '../lib/api-nav';

const { frontmatter } = Astro.props;
const { title, page = 'reference', description } = frontmatter ?? {};

// /reference/core/Class.GeoloniaMap/ の core からパッケージ名を引く。
// 同じ規則で OGP 画像の副題も作っている（src/pages/og/[...route].ts）。
const pkg = packageLabel(Astro.url.pathname.split('/').filter(Boolean)[1] ?? '');
---
<BaseLayout title={`${title} — Geolonia Docs`} page={page} description={description ?? `${pkg} の API リファレンス`}>
  <div class="doc-shell">
    <ApiNav />
    <main class="content api-doc">
      <slot />
    </main>
  </div>
</BaseLayout>
