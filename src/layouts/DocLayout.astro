---
// Markdown / MDX ページ用のレイアウト。frontmatter の layout で指定して使う。
//   ---
//   layout: ../../layouts/DocLayout.astro
//   title: ...
//   page: howto
//   kicker: ハウツー / レシピ   # 見出し上のアイキャッチ（旧 quadrant も可）
//   badge: tutorial            # 任意。H1 の頭に象限バッジを付ける
//   ---
import BaseLayout from './BaseLayout.astro';
import QuadBadge from '../components/QuadBadge.astro';
const { frontmatter } = Astro.props;
const { title, page = '', kicker, quadrant, badge } = frontmatter ?? {};
const eyebrow = kicker ?? quadrant;
const badgeLabels = { tutorial: 'チュートリアル', howto: 'ハウツー', reference: 'リファレンス', explanation: '解説' };
---
<BaseLayout title={`${title} — Geolonia Docs`} page={page}>
  <main class="content">
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    <h1>{badge && <><QuadBadge kind={badge}>{badgeLabels[badge]}</QuadBadge>{' '}</>}{title}</h1>
    <slot />
  </main>
</BaseLayout>
