---
/**
 * API リファレンスの左サイドバー（ツリー）。
 *
 * 自動生成ページ（ApiLayout）と、手書きの索引ページ /reference/（DocLayout に
 * sidebar: api を指定）の両方から使う。中身は src/pages/reference/*\/*.md を
 * 走査して組み立てるので、手で維持する一覧は持たない。
 *
 * 開閉は details/summary だけで行い、JS を持たない。
 */
import { buildApiTree } from '../lib/api-nav';

const pages = import.meta.glob('../pages/reference/*/*.md', { eager: true });
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const tree = buildApiTree(pages, currentPath);
---
<nav class="doc-nav" aria-label="API リファレンス">
  {tree.map((pkg) => (
    <details class="doc-nav__top" open={pkg.expanded}>
      <summary class="doc-nav__top-name doc-nav__top-name--mono">
        {pkg.label}
        {!pkg.expanded && <span class="doc-nav__count">{pkg.count}</span>}
      </summary>

      {pkg.index && (
        <a
          class:list={['doc-nav__link', 'doc-nav__link--index', { 'is-current': pkg.index.current }]}
          href={pkg.index.href}
          aria-current={pkg.index.current ? 'page' : undefined}
        >概要</a>
      )}

      {pkg.groups.map((group) => (
        <details class="doc-nav__group" open={group.current}>
          <summary class="doc-nav__group-name">
            {group.label}
            <span class="doc-nav__count">{group.items.length}</span>
          </summary>
          <ul class="doc-nav__list">
            {group.items.map((item) => (
              <li>
                <a
                  class:list={['doc-nav__link', { 'is-current': item.current }]}
                  href={item.href}
                  aria-current={item.current ? 'page' : undefined}
                >{item.name}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </details>
  ))}
</nav>
