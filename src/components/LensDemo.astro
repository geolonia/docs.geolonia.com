---
// 動くデモを遅延ロードの iframe で埋め込む。src は /demos/ 以下の
// 本体ミラーのパス（例 /demos/tutorials/maps-react/first-map/）。
// data-src だけ持たせ、BaseLayout の IntersectionObserver が
// ビューポートに入った時に src を設定して読み込む（タブの中でも単独でも動く）。
// 見た目は components.css の .lens-demo 側。
const { src, title } = Astro.props;
---
<div class="lens-demo">
  <iframe
    class="lens-demo__frame"
    data-src={src}
    title={title ?? 'ライブデモ'}
    loading="lazy"
  ></iframe>
</div>
